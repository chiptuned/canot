{"data": {"detail": "", "order_differs": true, "rows_source": 20, "rows_target": 20, "seconds_source": 0.001778334000846371, "seconds_target": 0.0024782920081634074, "sql": "select s.region, s.format, count(*) as tickets, sum(t.total) as revenue, avg(t.total) as basket\nfrom distrib.tickets t join distrib.stores s using (store_id)\ngroup by 1, 2 order by revenue desc", "status": "match", "translated": "SELECT s.region, s.format, COUNT(*) AS tickets, SUM(t.total) AS revenue, AVG(t.total) AS basket FROM distrib.tickets AS t JOIN distrib.stores AS s USING (store_id) GROUP BY 1, 2 ORDER BY revenue DESC"}, "event": "query", "hash": "b9b4ff94e33a01303a627768d94b57d12c2182511f94cda08b6402be3c329a86", "prev": "1e8a842fbbfc6d67244d2c3a1f6ca7a7c2b083a325b3e33c0cb15dbb413df859", "seq": 10, "ts": "2026-10-13T03:54:00+00:00"}
