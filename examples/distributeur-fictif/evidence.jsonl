{"data": {"detail": "", "order_differs": false, "rows_source": 5, "rows_target": 5, "seconds_source": 0.038569000011193566, "seconds_target": 0.034068417007802054, "sql": "select p.category, sum(l.qty * p.unit_price) as revenue\nfrom distrib.tickets t, unnest(t.lines) as u(l) join distrib.products p on p.product_id = l.product_id\ngroup by 1 order by 2 desc", "status": "match", "translated": "SELECT p.category, SUM(l.qty * p.unit_price) AS revenue FROM distrib.tickets AS t JOIN UNNEST(t.lines) AS u(l) ON TRUE JOIN distrib.products AS p ON p.product_id = l.product_id GROUP BY 1 ORDER BY 2 DESC"}, "event": "query", "hash": "ac3c6b1342a638687a662ad8a45f089280b9a715fafad94f4dd78d3c2ad3ae97", "prev": "d2ffdd76f920833de3751dd263f337bd9363f67eb520abd2f8b4ce9a403f0c81", "seq": 13, "ts": "2026-10-13T03:54:00+00:00"}
