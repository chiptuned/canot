  "queries": [
    {
      "sql": "select l_returnflag, l_linestatus, sum(l_quantity) as sum_qty, sum(l_extendedprice) as sum_base_price,\n       sum(l_extendedprice * (1 - l_discount)) as sum_disc_price, avg(l_discount) as avg_disc, count(*) as n\nfrom tpch.lineitem where l_shipdate <= date '1998-12-01' - interval '90' day\ngroup by 1, 2 order by 1, 2",
      "translated": "SELECT l_returnflag, l_linestatus, SUM(l_quantity) AS sum_qty, SUM(l_extendedprice) AS sum_base_price, SUM(l_extendedprice * (1 - l_discount)) AS sum_disc_price, AVG(l_discount) AS avg_disc, COUNT(*) AS n FROM tpch.lineitem WHERE l_shipdate <= CAST('1998-12-01' AS DATE) - INTERVAL '90' DAY GROUP BY 1, 2 ORDER BY 1, 2",
      "status": "match",
      "detail": "",
      "rows_source": 4,
      "rows_target": 4,
      "order_differs": false
    },
    {
      "sql": "select l_orderkey, sum(l_extendedprice * (1 - l_discount)) as revenue, o_orderdate\nfrom tpch.customer, tpch.orders, tpch.lineitem\nwhere c_mktsegment = 'BUILDING' and c_custkey = o_custkey and l_orderkey = o_orderkey\n  and o_orderdate < date '1995-03-15' and l_shipdate > date '1995-03-15'\ngroup by l_orderkey, o_orderdate order by revenue desc, o_orderdate limit 10",
      "translated": "SELECT l_orderkey, SUM(l_extendedprice * (1 - l_discount)) AS revenue, o_orderdate FROM tpch.customer, tpch.orders, tpch.lineitem WHERE c_mktsegment = 'BUILDING' AND c_custkey = o_custkey AND l_orderkey = o_orderkey AND o_orderdate < CAST('1995-03-15' AS DATE) AND l_shipdate > CAST('1995-03-15' AS DATE) GROUP BY l_orderkey, o_orderdate ORDER BY revenue DESC, o_orderdate LIMIT 10",
      "status": "match",
      "detail": "",
      "rows_source": 10,
      "rows_target": 10,
      "order_differs": false
    },
    {
      "sql": "select sum(l_extendedprice * l_discount) as revenue from tpch.lineitem\nwhere l_shipdate >= date '1994-01-01' and l_shipdate < date '1995-01-01' and l_discount between 0.05 and 0.07 and l_quantity < 24",
      "translated": "SELECT SUM(l_extendedprice * l_discount) AS revenue FROM tpch.lineitem WHERE l_shipdate >= CAST('1994-01-01' AS DATE) AND l_shipdate < CAST('1995-01-01' AS DATE) AND l_discount BETWEEN 0.05 AND 0.07 AND l_quantity < 24",
